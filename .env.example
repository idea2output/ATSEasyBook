# ATS Tech Environment Configuration Example
# Copy this file to .env.local to configure local developer overrides.

# ATS Imposition Endpoint
# Local development default: http://localhost:5173 (MyDraw Vite server)
NEXT_PUBLIC_IMPOSITION_URL=http://localhost:5173

# Production dedicated subdomain recommendation:
# NEXT_PUBLIC_IMPOSITION_URL=https://imposition.atstech.com

# Node environment
NODE_ENV=development
