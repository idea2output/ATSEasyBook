# ATS Tech Environment Configuration Example
# Copy this file to .env.local to configure local developer overrides.

# ATS Impose Endpoint
# Integrated mounting: mounts directly at /Impose/ on the same host
NEXT_PUBLIC_IMPOSITION_URL=/Impose/

# Production URL:
# NEXT_PUBLIC_IMPOSITION_URL=https://atstech.com/Impose/

# Node environment
NODE_ENV=development
